# PhantomOperator (Render free tier, no paid API keys needed). DO NOT commit a real .env.
PORT=3000
NODE_ENV=production
# x402 payouts: plain USDC on Base mainnet via the keyless PayAI facilitator
PAY_TO=0x3d95D4A6DbaE0Cd0643a82b13A13b08921D6ADf7
FACILITATOR_URL=https://facilitator.payai.network
# Optional: public URL (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=
# Rate limits (requests per IP per minute)
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_PAID=10
MAX_BODY_BYTES=65536

# Legacy scripts only (not used by server.js): register.js / Superfluid / Solana.
# Leave unset on Render. Never put a private key on a hosted service.
# PRIVATE_KEY=
# RPC_URL=https://mainnet.base.org
