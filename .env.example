# PhantomOperator example configuration — never commit a real .env file.

# Public service URL used in discovery documents.
PUBLIC_BASE_URL=https://your-public-domain.example
PORT=3000

# Base x402: native Base USDC, chain ID 8453.
PAYMENT_RECEIVER_ADDRESS=0xYourBaseUSDCReceiver
PAYMENT_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
CHAIN_ID=8453

# Coinbase CDP x402 facilitator credentials. Create and store these securely.
# CDP_API_KEY_NAME=
# CDP_API_KEY_PRIVATE_KEY=

# Optional MPP Tempo rail. Required only to expose /mpp/skills/*.
# MPP_SECRET_KEY=
# MPP_REALM=your-public-domain.example

# Optional service integrations.
# HIBP_API_KEY=

# Optional Monero invoice rail. Use a view-only monero-wallet-rpc wallet.
# The wallet RPC endpoint may include HTTP basic auth but must remain private.
# MONERO_WALLET_RPC_URL=http://user:password@127.0.0.1:18082/json_rpc
# MONERO_ACCOUNT_INDEX=0
# MONERO_MIN_CONFIRMATIONS=10
# MONERO_USD_PER_XMR=150.00
# MONERO_PROOF_SECRET=generate-a-long-random-secret
# MONERO_INVOICE_STORE=/secure/persistent/path/monero-invoices.json

# Limits
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_PAID=20
# Optional Stripe MPP rail. Run ./setup-stripe-mpp.sh locally to create these;
# never paste Stripe credentials into chat or commit them. Set false to disable.
# STRIPE_MPP_ENABLED=true
# STRIPE_SECRET_KEY=
# STRIPE_PROFILE_ID=
# TEMPO_DEPOSIT_ADDRESS=

# Maximum JSON request size. Must be a positive integer in bytes.
MAX_BODY_BYTES=16384
# Comma-separated origins allowed to call the API from a browser. Leave blank for same-origin only.
# CORS_ORIGINS=https://your-app.example

# Do not place Stripe, wallet private keys, CDP keys, or any credentials in source control.
